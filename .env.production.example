# Copy to `.env` next to docker-compose.prod.yml and fill in.

# Your existing PostgreSQL. Pick the form that matches where it runs:
#   Postgres in Docker, port published on the NAS   -> host.docker.internal:5432
#   Postgres in Docker, shared Docker network       -> <container-name>:5432
#   Postgres on another machine on the LAN          -> 192.168.1.50:5432
DATABASE_URL=postgres://padel:CHANGE_ME@host.docker.internal:5432/padel

# Passkeys only work over HTTPS. RP_ID is the hostname alone — no scheme,
# no port, no trailing slash. ORIGIN is the full URL the browser shows.
RP_ID=padel.example.synology.me
ORIGIN=https://padel.example.synology.me

# Shown inside the system passkey dialog.
RP_NAME=Падел Турниры
