# PostgreSQL
DATABASE_URL=postgres://padel:padel@localhost:5433/padel

# WebAuthn / passkeys
# RP_ID must be the site's registrable domain (no scheme, no port). Use "localhost" in dev.
RP_ID=localhost
RP_NAME=Padel Tournaments
# Full origin(s) the browser sees. Comma-separated if more than one.
ORIGIN=http://localhost:3000

# Yandex ID (optional). Without these two the "Войти с Яндекс ID" button is
# simply not shown; everything else works as before. Register the app at
# https://oauth.yandex.ru/client/new/id/ with scopes "login:info" and
# "login:email", and add this exact Redirect URI:
#   http://localhost:3000/api/auth/yandex/callback
# Keep dev and production apps separate — they need different Redirect URIs.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Only when the registered Redirect URI is not <first ORIGIN>/api/auth/yandex/callback.
# YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# Privacy policy (/privacy) — who processes the data and where to write about
# it. Read at request time, so a rebuild is not needed to change them. Set both
# if you run your own copy: the defaults name the original install's owner.
# PRIVACY_OPERATOR=Иван Иванов
# PRIVACY_EMAIL=privacy@example.com
