# PostgreSQL
DATABASE_URL=postgres://padel:padel@localhost:5433/padel

# WebAuthn / passkeys
# RP_ID must be the site's registrable domain (no scheme, no port). Use "localhost" in dev.
RP_ID=localhost
RP_NAME=Padel Tournaments
# Full origin(s) the browser sees. Comma-separated if more than one.
ORIGIN=http://localhost:3000

# Yandex ID (optional). Without these two the "Войти с Яндекс ID" button is
# simply not shown; everything else works as before. Register the app at
# https://oauth.yandex.ru/client/new/id/ — no permissions needed, the app only
# uses the Yandex id and login, which come with any token. Add this exact
# Redirect URI:
#   http://localhost:3000/api/auth/yandex/callback
# Keep dev and production apps separate — they need different Redirect URIs.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Only when the registered Redirect URI is not <first ORIGIN>/api/auth/yandex/callback.
# YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# Your own SSO — any OpenID Connect server, e.g. authentik (optional). Without
# the first three the SSO button is not shown. In authentik: create an
# OAuth2/OpenID provider (confidential client) and an application for it; the
# issuer is shown on the provider page. Redirect URI to allow:
#   http://localhost:3000/api/auth/sso/callback
SSO_ISSUER=
# SSO_ISSUER=https://auth.example.com/application/o/padel/
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Button label: "Войти через <SSO_NAME>". Defaults to "SSO".
SSO_NAME=authentik
# Only when the registered Redirect URI is not <first ORIGIN>/api/auth/sso/callback.
# SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
