// Padel Tournaments — схема v2.
//
// Здесь описано только то, что Prisma умеет моделировать: таблицы, связи,
// индексы и перечисления. Ограничения, которые Prisma не знает совсем —
// CHECK, отложенные триггеры и вью — лежат в SQL миграций.
//
// Граница проведена так намеренно: индексами и внешними ключами владеет
// Prisma (иначе `migrate dev` посчитает их дрейфом и снесёт), а всем, чего
// в её языке нет, — миграции. Пересечения нет, значит нет и конфликта.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TournamentFormat {
  americano
  mexicano
  team_americano

  @@map("tournament_format")
}

enum MatchSide {
  a
  b

  @@map("match_side")
}

enum ChallengeKind {
  registration
  authentication

  @@map("challenge_kind")
}

// Роли идут по возрастанию прав, и порядок здесь значащий: «повысить не выше
// себя» в lib/permissions.ts сравнивает именно места в этом списке.
enum ClubRole {
  member
  admin
  owner

  @@map("club_role")
}

// ============================================================================
// Аккаунты и вход
// ============================================================================

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Имя как ввёл пользователь, плюс нормализованный ключ для уникальности.
  // В v1 регистронезависимость держалась на `lower()` в SQL и на
  // toLocaleLowerCase('ru') в JS — две разные функции на один инвариант.
  // Теперь нормализует только TS (см. lib/normalize.ts), а база хранит
  // результат, поэтому разойтись им негде.
  username    String @db.Text
  usernameKey String @unique @map("username_key") @db.Text

  displayName String @map("display_name") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  credentials Credential[]
  sessions    Session[]
  challenges  WebauthnChallenge[]
  memberships ClubMember[]
  createdTournaments Tournament[]
  linkedTo    Person[]            @relation("PersonAccount")
  invitesMade ClubInvite[]

  @@map("users")
}

model Credential {
  id     String @id @db.Text // base64url credential ID
  userId String @map("user_id") @db.Uuid

  publicKey  Bytes    @map("public_key")
  counter    BigInt   @default(0)
  transports String[] @db.Text
  deviceType String?  @map("device_type") @db.Text
  backedUp   Boolean  @default(false) @map("backed_up")
  // Подпись от пользователя: «iPhone», «Рабочий ноут».
  label      String?  @db.Text

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}

model WebauthnChallenge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  challenge String        @db.Text
  kind      ChallengeKind
  userId    String?       @map("user_id") @db.Uuid
  username  String?       @db.Text
  // Зарезервированный user handle: станет users.id, если регистрация дойдёт
  // до конца, чтобы handle аутентификатора совпадал с нашим id.
  userHandle String? @map("user_handle") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("webauthn_challenges")
}

model Session {
  // sha256 значения из cookie: утечка дампа не даёт валидную сессию.
  tokenHash Bytes  @id @map("token_hash")
  userId    String @map("user_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// Клубы
//
// Ось, по которой всё разложено. Ростер и турниры принадлежат клубу, а не
// пользователю: аккаунт даёт вход, клуб — данные. Один человек состоит в
// скольких угодно клубах, и в каждом у него своя роль и свой игрок.
// ============================================================================

model Club {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name String @db.Text
  // Значок клуба: эмодзи и цвет фона из фиксированной палитры (lib/clubs.ts).
  // Картинки нет намеренно — файлового хранилища в проекте нет, а два
  // коротких текстовых поля переживают и офлайн, и рендер на сервере.
  icon  String @db.Text
  color String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  members     ClubMember[]
  people      Person[]
  tournaments Tournament[]
  invites     ClubInvite[]

  @@map("clubs")
}

// Членство: аккаунт, роль и игрок, которым этот человек выступает в клубе.
//
// Игрок обязателен — «участник клуба, не связанный с игроком» невозможен по
// построению. Ссылка на него живёт в people.user_id, а не колонкой здесь:
// одна дорога к связи вместо двух, и разойтись им негде. Что она есть у
// каждого участника, стережёт отложенный триггер в миграции — это
// утверждение про строки чужой таблицы, ограничением его не выразить.
model ClubMember {
  clubId String   @map("club_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  role   ClubRole @default(member)

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
  @@map("club_members")
}

// Ссылка-приглашение. В URL уходит случайный токен, здесь лежит только его
// sha256 — ровно по той же причине, что и у сессий: дамп базы не должен
// давать рабочее приглашение.
//
// Активная ссылка у клуба одна: выпуск новой гасит прежние (revokedAt).
// Уникальным индексом это не выразить — «активна» зависит от now(), — да и
// не нужно: гасит их одним UPDATE тот же код, что выпускает новую.
model ClubInvite {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId String @map("club_id") @db.Uuid

  // Открытым текстом, а не хешем, как у сессий: ссылка должна быть видна на
  // экране клуба с любого устройства и после перезагрузки, а не только там,
  // где её выпустили. Цена этого решения мала — приглашение даёт роль
  // участника и ничего больше, — а хеш её бы этого не позволил в принципе:
  // из хеша исходное значение не достать.
  token String @unique @db.Text

  // Кто выпустил. Аккаунт может исчезнуть, ссылка от этого не портится.
  createdById String? @map("created_by_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([expiresAt])
  @@map("club_invites")
}

// ============================================================================
// Люди
//
// Единственное место, где живёт имя человека: участник турнира ссылается
// сюда, копии имени нет. Удаления нет — onDelete: Restrict плюс archivedAt,
// поэтому «удалить из ростера» значит заархивировать, а история цела.
// ============================================================================

model Person {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId String @map("club_id") @db.Uuid

  name    String @db.Text
  nameKey String @map("name_key") @db.Text

  // Аккаунт, который выступает этим игроком. По умолчанию пусто: игроки клуба
  // анонимны, пока кто-нибудь не назовёт себя одним из них, приняв
  // приглашение. Выход из клуба снимает связь обратно.
  userId String? @map("user_id") @db.Uuid

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  club    Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  account User?              @relation("PersonAccount", fields: [userId], references: [id], onDelete: SetNull)
  entries TournamentPlayer[]

  // Уникальность действует и на архив: повторный ввод имени должен
  // разархивировать человека, а не создать двойника.
  @@unique([clubId, nameKey])
  // Один аккаунт — не больше одного игрока в клубе. NULL здесь не мешают:
  // Postgres по умолчанию считает их различными, поэтому анонимных игроков
  // может быть сколько угодно, а вот назвать себя дважды нельзя.
  @@unique([clubId, userId])
  @@index([clubId, name])
  @@map("people")
}

// ============================================================================
// Турниры
// ============================================================================

model Tournament {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId String @map("club_id") @db.Uuid

  // Кто завёл турнир. На права не влияет — их даёт роль в клубе, — но без
  // этого не ответить на «кто это создал», а аккаунт может и исчезнуть.
  createdById String? @map("created_by_id") @db.Uuid

  name           String           @db.Text
  format         TournamentFormat @default(americano)
  courts         Int              @db.SmallInt
  pointsPerMatch Int              @map("points_per_match") @db.SmallInt

  // Сколько раундов играть. Есть только у mexicano: там расписание строится
  // по ходу дела, раунд за раундом, и само по себе не кончается. У американо
  // длину задаёт «каждый с каждым», поэтому здесь NULL — за этим следит
  // CHECK tournaments_rounds_planned_format.
  roundsPlanned Int? @map("rounds_planned") @db.SmallInt

  // Статуса нет: он выводится из этих двух меток (вью tournament_overview).
  // completedAt — внесён счёт последнего матча; closedAt — завершён досрочно.
  // Обе идемпотентны и не сдвигаются при правке счёта.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  players   TournamentPlayer[]
  matches   Match[]

  @@index([clubId, createdAt(sort: Desc)])
  @@map("tournaments")
}

// Участник турнира. seat — порядок ввода, 0-based: индекс N в расписании от
// генератора соответствует seat = N.
model TournamentPlayer {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String @map("tournament_id") @db.Uuid
  personId     String @map("person_id") @db.Uuid
  seat         Int    @db.SmallInt

  tournament  Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  person      Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  appearances MatchParticipant[]

  @@unique([tournamentId, seat])
  // Один человек не может занять два места в одном турнире.
  @@unique([tournamentId, personId])
  // Мишень для составного внешнего ключа из MatchParticipant.
  @@unique([id, tournamentId])
  @@index([personId])
  @@map("tournament_players")
}

model Match {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId String @map("tournament_id") @db.Uuid

  roundNo Int @map("round_no") @db.SmallInt
  courtNo Int @map("court_no") @db.SmallInt

  // Копия tournaments.pointsPerMatch на момент создания. Делает инвариант
  // суммы проверяемым в базе (иначе он межтабличный) и защищает уже сыгранные
  // матчи, если норму турнира когда-нибудь разрешат менять.
  pointsSum Int? @map("points_sum") @db.SmallInt

  scoreA   Int?      @map("score_a") @db.SmallInt
  scoreB   Int?      @map("score_b") @db.SmallInt
  playedAt DateTime? @map("played_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  @@unique([tournamentId, roundNo, courtNo])
  // Мишень для составного внешнего ключа: тащит roundNo, чтобы база могла
  // проверить «игрок не занят дважды в одном раунде».
  @@unique([id, tournamentId, roundNo])
  @@map("matches")
}

// Кто играл в матче.
//
// В паделе на корте всегда четверо: 2 на 2. Меняется способ разбивки на пары
// (американо, мексикано, фиксированные пары), а не число мест — поэтому slot
// ограничен двумя значениями, и этого хватает всем планируемым форматам.
//
// Что проверяет база:
//   * игрок не встречается в матче дважды           — @@id
//   * на стороне не больше двух                     — @@unique([matchId, side, slot]) + CHECK
//   * участник из того же турнира, что и матч       — составной внешний ключ
//   * игрок не занят на двух кортах в одном раунде  — @@unique([tournamentId, roundNo, ...])
//   * ровно четверо, не трое                        — отложенный триггер в миграции
model MatchParticipant {
  matchId String @map("match_id") @db.Uuid
  // Копия matches.roundNo: существует ради @@unique ниже, держится в согласии
  // составным внешним ключом с onUpdate: Cascade.
  roundNo Int    @map("round_no") @db.SmallInt

  tournamentId       String    @map("tournament_id") @db.Uuid
  tournamentPlayerId String    @map("tournament_player_id") @db.Uuid
  side               MatchSide
  slot               Int       @db.SmallInt

  match  Match            @relation(fields: [matchId, tournamentId, roundNo], references: [id, tournamentId, roundNo], onDelete: Cascade, onUpdate: Cascade)
  player TournamentPlayer @relation(fields: [tournamentPlayerId, tournamentId], references: [id, tournamentId], onDelete: Cascade)

  @@id([matchId, tournamentPlayerId])
  @@unique([matchId, side, slot])
  @@unique([tournamentId, roundNo, tournamentPlayerId])
  // Ключевой индекс: делает статистику по человеку обходом по индексу вместо
  // полного скана matches, как было при раскладке по четырём колонкам.
  @@index([tournamentPlayerId])
  @@map("match_participants")
}
